#VRML_SIM R2025a utf8
# tags: hidden
# template language: javascript
# Rugged 5-spoke beadlock off-road drive wheel. Physics & contact geometry unchanged.
PROTO RescueRoverWheel [
  field SFVec3f anchor 0 0 .09
  field SFString name "drive wheel"
  field SFString motorName "drive_motor"
  field SFString encoderName ""
] {
  
  HingeJoint {
    jointParameters HingeJointParameters {
      axis 0 1 0
      anchor IS anchor
      dampingConstant .01
    }
    device [
      # Webots relays commands to motors that share the prefix before "::".
      RotationalMotor { name IS motorName maxVelocity 10 maxTorque 2.5 sound "" }
      
        PositionSensor { name IS encoderName }
      
    ]
