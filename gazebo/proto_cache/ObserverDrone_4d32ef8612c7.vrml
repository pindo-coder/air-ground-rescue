#VRML_SIM R2025a utf8
# template language: javascript
# Industrial-grade kinematic survey quadrotor (Matrice-class aesthetic) with nadir RGB-D payload.
# All sensor poses, names, FOVs and downward optical clearance (z = -.20) strictly preserved.
EXTERNPROTO "BeveledBox.proto"

PROTO ObserverDrone [
  field SFVec3f translation -17 -9 9.5
  field SFRotation rotation 0 0 1 0
  field SFString controller "aerial_observer"
] {
  
  Robot {
    translation IS translation
    rotation IS rotation
    name "Aerial RGB-D observer"
    controller IS controller
    window "<none>"
    children [
      # === 1. SLEEK LOW-PROFILE 3K CARBON & TITANIUM CENTER AIRFRAME ===
      # Lower structural carbon-fiber chassis plate
      Pose {
        translation 0 0 -.024
        children [
          Shape {
            appearance DEF CARBON_FRAME PBRAppearance {
              baseColorMap ImageTexture { url [ "textures/carbon_weave_base.png" ] }
              normalMap ImageTexture { url [ "textures/carbon_weave_normal.png" ] }
              normalMapFactor 0.35
              textureTransform TextureTransform { scale 7 5 }
              roughness .44
              metalness .20
            }
            geometry BeveledBox { size .335 .218 .024 bevel .008 }
          }
        ]
      }
      # Mid CNC brushed-gunmetal avionics core bay
      Pose {
        translation 0 0 .006
        children [
          Shape {
            appearance DEF GUNMETAL PBRAppearance {
              baseColor .65 .68 .71
              baseColorMap ImageTexture { url [ "textures/brushed_metal_base.png" ] }
              normalMap ImageTexture { url [ "textures/brushed_metal_normal.png" ] }
              normalMapFactor 0.22
              textureTransform TextureTransform { scale 4 3 }
              roughness .36
              metalness .78
            }
            geometry BeveledBox { size .368 .224 .036 bevel .009 }
          }
        ]
      }
      # Upper stealth-faceted carbon-fiber top deck
      Pose {
        translation -.004 0 .036
        children [
          Shape {
            appearance USE CARBON_FRAME
            geometry BeveledBox { size .342 .204 .024 bevel .009 }
          }
        ]
      }
      # Subtle anodized rescue-orange center accent band along fuselage waist
      Pose {
        translation 0 0 .022
        children [
          Shape {
            appearance DEF RESCUE_ORANGE PBRAppearance {
              baseColor .86 .25 .06
              roughness .38
              metalness .24
            }
            geometry BeveledBox { size .372 .227 .006 bevel .0015 }
          }
        ]
      }
      # High-res tactical survey stencil plate flush on top deck
      Shape {
        appearance PBRAppearance {
          baseColorMap ImageTexture { url [ "textures/rescue_drone_id.png" ] }
          roughness .46
          metalness .12
        }
        geometry IndexedFaceSet {
          coord Coordinate {
            point [ -.112 -.054 .0488, .104 -.054 .0488, .104 .054 .0488, -.112 .054 .0488 ]
          }
          coordIndex [ 0 1 2 3 -1 ]
          texCoord TextureCoordinate { point [ 0 0, 1 0, 1 1, 0 1 ] }
        }
      }

      # Front binocular obstacle-avoidance optical pod + status strobe
      Pose {
        translation .184 0 .008
        children [
          Shape { appearance DEF MATTE_BLACK PBRAppearance { baseColor .07 .085 .095 roughness .72 metalness .20 }
                  geometry BeveledBox { size .024 .136 .028 bevel .005 } }
          
            Pose {
              translation .012 -0.042 0
              rotation 0 1 0 1.5707963268
              children [
                Shape { appearance DEF RAW_ALU PBRAppearance { baseColor .56 .60 .62 roughness .30 metalness .85 }
                        geometry Cylinder { radius .011 height .004 subdivision 24 } }
                Pose {
                  translation 0 0 .002
                  children [
                    Shape { appearance DEF OPTICAL_GLASS PBRAppearance { baseColor .02 .04 .06 roughness .06 metalness .32 }
                            geometry Cylinder { radius .008 height .0025 subdivision 24 } }
                  ]
                }
              ]
            }
          
